# Port de l'application (défaut : 8501)
APP_PORT=8501

# Chemin ABSOLU vers le dossier de données sur le Mac de l'utilisateur
# IMPORTANT : ne pas utiliser ~ ici, Docker n'interprète pas le tilde
# Remplacer "votre-nom" par le nom d'utilisateur macOS réel
DB_PATH=/Users/votre-nom/.ministere-info/data
