# ============================================================
# Variables d'environnement — ministere-de-l-info
# ============================================================
# Copier ce fichier en .env et remplir les valeurs réelles.
# Le .env est GITIGNORED — il ne sera jamais poussé sur GitHub.
# ============================================================

# --- Anthropic API (génération de rapports assistée) ---
# Obtenir une clé sur https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- INSEE API (portail-api.insee.fr) ---
# Créer un compte sur https://portail-api.insee.fr/
# Créer une application, souscrire aux APIs Sirene + Métadonnées, récupérer les clés
INSEE_CLIENT_KEY=
INSEE_CLIENT_SECRET=

# --- Légifrance via PISTE (textes législatifs, JO) ---
# S'inscrire sur https://piste.gouv.fr/registration
# Créer une app sandbox ET une app production (séparées)
# Accepter les CGU Légifrance dans l'espace utilisateur
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
PISTE_ENV=sandbox  # ou "production"

# --- Banque de France Webstat (optionnel) ---
# Clé gratuite sur https://webstat.banque-france.fr/
BANQUE_DE_FRANCE_API_KEY=

# --- Configuration application ---
APP_ENV=development  # development | production
LOG_LEVEL=INFO
