<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  MODÈLE du LaunchAgent de sauvegarde quotidienne de la base.
  Ne pas copier tel quel : deploy/native/install-native.sh remplace les
  marqueurs @...@ et installe le résultat dans
  ~/Library/LaunchAgents/com.crocdeine.ministere-info.backup.plist
  (même identifiant que l'ancienne version : l'ancien agent est remplacé).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>@LABEL@</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@PROJECT_DIR@/scripts/backup_db.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@PROJECT_DIR@</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@PATH@</string>
        <key>MINISTERE_PROJECT_DIR</key>
        <string>@PROJECT_DIR@</string>
        <!-- La base réellement lue par l'application native -->
        <key>MINISTERE_DB_PATH</key>
        <string>@DB_PATH@</string>
        <key>BACKUP_DEST</key>
        <string>@BACKUP_DEST@</string>
        <key>BACKUP_RETENTION_DAYS</key>
        <string>@RETENTION@</string>
        <key>BACKUP_LOG</key>
        <string>@LOG_DIR@/backup.log</string>
    </dict>

    <!-- Chaque jour à 3 h 00. Si le Mac dort à cette heure, launchd lance la
         sauvegarde au réveil ; s'il est éteint, elle est sautée ce jour-là. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Pas d'exécution au chargement (ni à l'ouverture de session) -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Priorité basse : ne gêne pas l'usage du Mac -->
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>@LOG_DIR@/backup.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>@LOG_DIR@/backup.launchd.err.log</string>
</dict>
</plist>
